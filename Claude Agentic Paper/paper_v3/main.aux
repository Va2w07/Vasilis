\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Quartz--air--Si, six knots ($\sigma =\num {9.0e-4}$, raised by pre-pulse noise bursts; white level below that of Fig.~\ref {fig:expfit}). (a) Pulse and fit; (b) residuals, stage~1 (tied) and 2 (free); (c) spectra, fit band shaded. Freeing the knots: loss $3.62\to 2.93\times 10^{-3}$ ($-\SI {19}{\percent }$), MAE $4.0\sigma \to 3.2\sigma $.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:qasfit}{{5}{7}{Quartz--air--Si, six knots ($\sigma =\num {9.0e-4}$, raised by pre-pulse noise bursts; white level below that of Fig.~\ref {fig:expfit}). (a) Pulse and fit; (b) residuals, stage~1 (tied) and 2 (free); (c) spectra, fit band shaded. Freeing the knots: loss $3.62\to 2.93\times 10^{-3}$ ($-\SI {19}{\percent }$), MAE $4.0\sigma \to 3.2\sigma $}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Six-knot quartz--air--Si fit: (a), (b) $n(f)$, (c), (d) $\kappa (f)$; stage~1 dotted. Bands: noise-limited (CR) $1\sigma $, 6.4 times wider with the residual RMS; the Si $n$ band is mostly a common offset (thickness-transfer valley), and at residual-scaled bounds the high-resistivity Si (HR-Si) value \cite  {Dai2004} (dashed) is two bounds from the knot mean. Hollow: unconstrained band-edge knots.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:qasnk}{{6}{7}{Six-knot quartz--air--Si fit: (a), (b) $n(f)$, (c), (d) $\kap (f)$; stage~1 dotted. Bands: noise-limited (CR) $1\sigma $, 6.4 times wider with the residual RMS; the Si $n$ band is mostly a common offset (thickness-transfer valley), and at residual-scaled bounds the high-resistivity Si (HR-Si) value \cite {Dai2004} (dashed) is two bounds from the knot mean. Hollow: unconstrained band-edge knots}{figure.caption.9}{}}
