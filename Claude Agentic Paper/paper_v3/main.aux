\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Quartz/Si end points ($d$ in \si {\micro \metre }). Starts: $n_{\mathrm  q}=1.982/1.900/2.010$, $d_{\mathrm  q}=1000/900/900$, $\kappa _{\mathrm  q}=0.0071$; Si $3.40/0.0054/400$. Adam: lowest-loss iterate (start 3); softplus, L-BFGS: start 1. Six knots: the model of Section~\ref {sec:disp} on these data, no hinge; ranges over the Si knots. Adhesive: $n\in [1.4,1.8]$ (at 1.40). rMSE change relative to row 4: $-5.0$, $-4.3$, $-57$, \SI {-59}{\percent } (rows 5--8). CR bounds grow 41-fold with the residual RMS.}}{4}{table.caption.4}\protected@file@percent }
\newlabel{tab:exp}{{2}{4}{Quartz/Si end points ($d$ in \si {\micro \metre }). Starts: $\nq =1.982/1.900/2.010$, $\dq =1000/900/900$, $\kq =0.0071$; Si $3.40/0.0054/400$. Adam: lowest-loss iterate (start 3); softplus, L-BFGS: start 1. Six knots: the model of Section~\ref {sec:disp} on these data, no hinge; ranges over the Si knots. Adhesive: $n\in [1.4,1.8]$ (at 1.40). rMSE change relative to row 4: $-5.0$, $-4.3$, $-57$, \SI {-59}{\percent } (rows 5--8). CR bounds grow 41-fold with the residual RMS}{table.caption.4}{}}
